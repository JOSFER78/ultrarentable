# ------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-*
*.duckdb
*.duckdb.wal
*.tmp.db
*.temp.db
.local/

# ------------------------------------------
# 4. Logs, Dumps & Diagnostics
# ------------------------------------------
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.out
*.pid
*.seed

# ------------------------------------------
# 5. Heavy Datasets, Artifacts & Scratch
# ------------------------------------------
artifacts/
data/artifacts/
data/raw/
data/quarantine/
scratch/
tmp/
temp/
.cache/

# ------------------------------------------
