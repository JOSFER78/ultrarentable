# ------------------------------------------
.env
.env.*
.env*.local
!.env.example
!.env.template
*.pem
*.key
*.cert
*.crt
*.pfx

# ------------------------------------------
# 7. OS & IDE Configuration
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
Thumbs.db
desktop.ini

# Editors
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# VS Code (preserve shared configuration)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
idea/

# Heavy/temporary data and artifacts
data/raw/
data/artifacts/
artifacts/
*.log
data/evidence/

# Datasets derivados: regenerables desde Binance/Dukascopy con los scripts de ingesta.
# Son la misma clase de artefacto que data/raw/ y data/artifacts/ (ya excluidos) y suponian
# el 99,8 % del pack de push (307 MB en un solo commit), lo que hacia fallar el push a
# GitHub con HTTP 408 de forma sistematica.
# IMPORTANTE: los *_manifest.json SI se versionan -- son la evidencia REAL-ONLY
# (checksum_sha256, record_count, coverage_pct, gap_count) que permite verificar que un
# dataset regenerado es identico al usado en una certificacion. Pesan KB.
data/normalized/*
!data/normalized/*_manifest.json
data/sqx_imports/
data/sqx_exports/
data/dukascopy_backfill_progress.json

# 2026-09-01 (ORQ): copia de un paquete `next` de node_modules roto por dos `npm install`
# concurrentes (ENOTEMPTY/EPERM). Se conserva en disco por la regla "nunca rm" pero no se
# versiona: son miles de ficheros de dependencia, no código del proyecto. Ver su MOTIVO.md.
cuarentena/npm_next_roto_20260901/*
!cuarentena/npm_next_roto_20260901/MOTIVO.md

# Orchestration local web/API logs and PIDs
orchestration/site/*.log
orchestration/site/local.pids.json
orchestration/site/local.pids.*.json

