venv/
env/
ENV/
.env/
virtualenv/
__pycache__/
*.py[cod]
*$py.class
*.so

# Python distribution & packaging
dist/
build/
*.egg-info/
*.egg
.eggs/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg

