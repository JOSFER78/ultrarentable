# 2. Node, TypeScript & Next.js Ecosystem
# ------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build outputs & caches
.next/
**/.next/
out/
**/out/
.turbo/
.vercel/

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------
